# Fish Audio API key from https://fish.audio/app/api-keys
# The booth still restyles every line without a key. Speech falls back to the browser voice.
FISH_API_KEY=

# drama-3 follows acting directions and is $10 per million characters.
# s2.1-pro-free spends $0. s2.1-pro is $15 per million characters.
FISH_MODEL=drama-3

PORT=5173
