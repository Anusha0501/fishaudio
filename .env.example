# Fish Audio API key from https://fish.audio/app/api-keys
# The booth still restyles every line without a key. Speech falls back to the browser voice.
FISH_API_KEY=

# s2.1-pro-free spends $0. Switch to s2.1-pro when you want the paid tier.
# $20 at $15 per million UTF-8 bytes is about 16 hours of speech.
FISH_MODEL=s2.1-pro-free

PORT=5173
